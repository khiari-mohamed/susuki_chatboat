generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// NEW DATA TABLES (production data)
// ═══════════════════════════════════════════════════════════════════

// ============================================
// Parts Catalog
// Source: 01_PROD_Item + 02_PARTS_Item (merged, deduplicated)
// ============================================
model Part {
  id                Int       @id @default(autoincrement())
  reference         String    @unique @db.VarChar(50)
  designation       String    @db.Text
  searchDescription String?   @map("search_description") @db.VarChar(100)
  designation2      String?   @map("designation_2") @db.VarChar(100)
  prixHt            Decimal?  @map("prix_ht") @db.Decimal(10, 3)
  prixTtc           Decimal?  @map("prix_ttc") @db.Decimal(10, 3)
  unite             String?   @db.VarChar(20)
  categorie         String?   @db.VarChar(50)
  fabricant         String?   @db.VarChar(100)
  fournisseurCode   String?   @map("fournisseur_code") @db.VarChar(50)
  source            String    @db.VarChar(20)    // '01_PROD' or '02_CARPRO'
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  stock             Stock?
  fitments          Fitment[]
  itemReferences    ItemReference[]

  @@map("parts")
  @@index([categorie])
  @@index([fabricant])
  @@index([fournisseurCode])
  @@index([designation(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ============================================
// Stock (aggregated per reference)
// Source: 05_Stock (GROUP BY Item No_, SUM Quantity)
// ============================================
model Stock {
  id            Int      @id @default(autoincrement())
  reference     String   @unique @db.VarChar(50)
  totalQuantity Int      @default(0) @map("total_quantity")
  statut        String   @default("Indisponible") @db.VarChar(20)
  updatedAt     DateTime @updatedAt @map("updated_at")

  part          Part     @relation(fields: [reference], references: [reference])

  @@map("stock")
  @@index([statut])
}

// ============================================
// Vehicle Type Master
// Source: bloker_Vehicle Type master.csv (43 rows)
// ============================================
model VehicleTypeMaster {
  id        Int       @id @default(autoincrement())
  typeCode  String    @unique @map("type_code") @db.VarChar(30)
  modelName String    @map("model_name") @db.VarChar(100)

  fitments  Fitment[]

  @@map("vehicle_type_master")
}

// ============================================
// Fitment – part to vehicle type compatibility
// Source: 03_Vehicle_Fitment (9,504 rows)
// ============================================
model Fitment {
  id            Int               @id @default(autoincrement())
  partReference String            @map("part_reference") @db.VarChar(50)
  typeCode      String            @map("type_code") @db.VarChar(30)
  modelName     String            @map("model_name") @db.VarChar(100)

  part          Part              @relation(fields: [partReference], references: [reference])
  vehicleType   VehicleTypeMaster @relation(fields: [typeCode], references: [typeCode])

  @@unique([partReference, typeCode])
  @@map("fitment")
  @@index([typeCode])
  @@index([modelName])
  @@index([partReference])
}

// ============================================
// Vehicles – master registry
// Source: 11_Vehicle (28,830 rows)
// ============================================
model Vehicle {
  id                 Int     @id @default(autoincrement())
  vehicleNo          String  @unique @map("vehicle_no") @db.VarChar(20)
  vin                String? @db.VarChar(25)  // Changed from 17 to 25 to accommodate longer VINs
  marque             String? @db.VarChar(20)
  modele             String? @db.VarChar(20)
  modeleDescription  String? @map("modele_description") @db.VarChar(100)
  statut             String? @db.VarChar(20)

  @@map("vehicles")
  @@index([vin])
  @@index([modele])
}

// ============================================
// Item References – alternate barcodes / OEM references
// Source: 04_Item_Reference (7,194 rows)
// ============================================
model ItemReference {
  id             Int    @id @default(autoincrement())
  partReference  String @map("part_reference") @db.VarChar(50)
  referenceNo    String @map("reference_no") @db.VarChar(50)
  referenceType  String? @map("reference_type") @db.VarChar(20)

  part           Part   @relation(fields: [partReference], references: [reference])

  @@unique([partReference, referenceNo])
  @@map("item_references")
  @@index([referenceNo])
}

// ============================================
// Synonyms – NLP dialect/synonym expansion
// Seeded manually after import
// ============================================
model Synonym {
  id        Int    @id @default(autoincrement())
  mot       String @db.VarChar(100)      // user input
  canonical String @db.VarChar(100)      // DB search term
  langue    String @default("fr") @db.VarChar(5) // 'fr' | 'tn'

  @@unique([mot, langue])
  @@map("synonyms")
  @@index([mot])
  @@index([canonical])
}

// ═══════════════════════════════════════════════════════════════════
// CHAT / INFRASTRUCTURE TABLES (unchanged)
// ═══════════════════════════════════════════════════════════════════

model ChatSession {
  id          String        @id @default(uuid())
  vehicleInfo Json?         @map("vehicle_info")
  startedAt   DateTime      @default(now()) @map("started_at")
  endedAt     DateTime?     @map("ended_at")
  metadata    Json?
  messages    ChatMessage[]
  prompts     ChatPrompt[]

  @@map("chat_sessions")
  @@index([startedAt])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  sender    String
  message   String      @db.Text
  timestamp DateTime    @default(now())
  metadata  Json?
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback  ChatFeedback?

  @@map("chat_messages")
  @@index([sessionId])
  @@index([timestamp])
}

model ChatPrompt {
  id           String      @id @default(uuid())
  sessionId    String      @map("session_id")
  promptText   String      @map("prompt_text") @db.Text
  responseText String      @map("response_text") @db.Text
  model        String?
  tokens       Int?
  createdAt    DateTime    @default(now()) @map("created_at")
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_prompts")
  @@index([sessionId])
  @@index([createdAt])
}

model ChatFeedback {
  id        String      @id @default(uuid())
  messageId String      @unique @map("message_id")
  rating    Int?
  comment   String?     @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("chat_feedback")
  @@index([rating])
}

model UploadTracking {
  id        String   @id @default(uuid())
  userIp    String   @map("user_ip") @db.VarChar(45)
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  success   Boolean  @default(true)
  vehicleInfo Json?  @map("vehicle_info")

  @@map("upload_tracking")
  @@index([userIp, uploadedAt])
  @@index([uploadedAt])
}