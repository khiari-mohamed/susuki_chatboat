# Database Configuration (REQUIRED)
DATABASE_URL="postgresql://user:password@localhost:5432/suzuki_db?schema=public"

# AI Services (REQUIRED)
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI (Optional - for future cross-validation)
OPENAI_API_KEY="your-openai-api-key-here"

# Server Configuration
PORT=8000
NODE_ENV=development

# Frontend URLs for CORS
FRONTEND_URL="http://localhost:3000"
PRODUCTION_FRONTEND_URL="https://your-production-domain.com"

# Optional: Rate Limiting
MAX_UPLOADS_PER_MONTH=3
MAX_CARTE_GRISE_UPLOADS=3
